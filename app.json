{
  "expo": {
    "name": "Bright Cakes & Snacks",
    "slug": "bright-cakes-snacks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "brightcakes",
    "userInterfaceStyle": "light",
    "primaryColor": "#352820",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.brightcakes.snacks",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Bright Cakes needs access to your photos so you can attach product and receipt pictures.",
        "NSCameraUsageDescription": "Bright Cakes needs the camera so you can photograph receipts."
      }
    },
    "android": {
      "package": "in.brightcakes.snacks",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "backgroundColor": "#FAF8F4",
        "resizeMode": "contain",
        "dark": {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAF8F4"
        }
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/f3a7ed9d-c1b4-4e4e-9caa-8fdeb4334fc6",
      "channel": "production",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-splash-screen",
      "expo-updates",
      "./plugins/withOfflineRelease",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bright Cakes needs access to your photos so you can attach product and receipt pictures.",
          "cameraPermission": "Bright Cakes needs the camera so you can photograph receipts."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Light.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Newsreader-Regular.ttf",
            "./assets/fonts/Newsreader-Medium.ttf",
            "./assets/fonts/Newsreader-Italic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f3a7ed9d-c1b4-4e4e-9caa-8fdeb4334fc6"
      }
    },
    "owner": "mhm.karthick"
  }
}
